# Local self-hosting defaults. Copy this file to .env before running Docker Compose.
ORIGIN=http://localhost:8080
WEB_PORT=8080
CLUB_NAME=openGym

# Optional access control. Register your profile first, then add its user id here.
ADMIN_UIDS=
INVITE_ONLY=0

# Session lifetime for newly issued cookies.
SESSION_DAYS=90

# Rate limiting. docker-compose sets TRUST_PROXY=1 itself (the API port is not published —
# only the compose nginx is in front of it). Set TRUST_PROXY to the number of trusted proxy
# hops if you run the API behind your own proxy outside compose; leave 0 when there is none.
# TRUST_PROXY=1
# LOGIN_IP_MAX=30          # failed logins per IP per 15 min
# REGISTER_IP_MAX=10       # sign-up attempts per IP per hour (one gym may share an IP — raise it if needed)
# CREDENTIALS_IP_MAX=10    # credential changes per IP per hour
