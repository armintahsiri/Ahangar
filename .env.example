# Local self-hosting defaults. Copy this file to .env before running Docker Compose.
ORIGIN=http://localhost:8080
WEB_PORT=8080
CLUB_NAME=openGym

# Optional access control. Register your profile first, then add its user id here.
ADMIN_UIDS=
INVITE_ONLY=0

# Session lifetime for newly issued cookies.
SESSION_DAYS=90

# Rate limiting. TRUST_PROXY = how many proxy hops sit in front of the API, i.e. how many
# entries at the RIGHT end of X-Forwarded-For belong to infrastructure you control:
#   compose as shipped (only its own nginx)                     → 1
#   your own TLS terminator in front of the compose nginx        → 2
#   Cloudflare (or similar CDN) on top of that                   → 3
# Wrong values make every member share one IP bucket — the per-IP throttles then apply to the
# whole gym at once. Leave it at 0 only when nothing proxies the API.
# TRUST_PROXY=1
# LOGIN_IP_MAX=30          # failed logins per IP per 15 min
# REGISTER_IP_MAX=10       # sign-up attempts per IP per hour (one gym may share an IP — raise it if needed)
# CREDENTIALS_IP_MAX=10    # credential changes per IP per hour
